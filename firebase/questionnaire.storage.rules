// Cloud Storage rules for index.html logo uploads.
//
// Paste this whole file into Firebase console > Storage > Rules for the
// engler-questionnaire project, replacing what's there, then Publish.
//
// Clients can upload design files up to 20 MB but cannot list, read, overwrite
// or delete anything. Only the admin account (signed in on responses.html) can
// view or delete uploads. isAdmin() below holds the admin user's
// UID; it comes from Authentication > Users.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'TyahIAOe0ZgcOZC1d8xOf0j0DrT2';
    }

    match /questionnaireUploads/{submissionId}/{fileName} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.size < 20 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType in [
                             'application/pdf',
                             'application/postscript',
                             'application/illustrator',
                             'application/octet-stream'
                           ]);
    }

  }
}
