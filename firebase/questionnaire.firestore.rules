// Firestore rules for client-form.html.
//
// Paste this whole file into Firebase console > Firestore Database > Rules for
// the engler-questionnaire project, replacing what's there, then Publish.
//
// Anyone can create a submission. Only the admin account (signed in on
// portal.html) can read or delete them, and nobody can edit one.
// questionnaireReviews holds one doc per submission the team has opened, so
// the Team Portal can show how many are still unreviewed. Admin only.
// orderTotals is public by order number; see below.
// questionnaireFees holds the fees, discounts and edited item list from the
// Appraisals page, one doc per submission. Admin only.
// isAdmin() below holds the admin user's UID from
// Authentication > Users.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'TyahIAOe0ZgcOZC1d8xOf0j0DrT2';
    }

    match /questionnaireSubmissions/{submissionId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['companyName', 'answers', 'contacts', 'files', 'summary', 'submittedAt', 'userAgent'])
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() <= 200
                    && request.resource.data.answers is map
                    && request.resource.data.answers.size() <= 60
                    && request.resource.data.answers['AI Workflow Acknowledged'] == 'Yes'
                    && request.resource.data.contacts is list
                    && request.resource.data.contacts.size() <= 20
                    && request.resource.data.files is list
                    && request.resource.data.files.size() <= 20
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 100000
                    && request.resource.data.submittedAt == request.time;
    }

    match /questionnaireReviews/{submissionId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['reviewedAt'])
                            && request.resource.data.reviewedAt == request.time;
    }

    match /questionnaireFees/{submissionId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['fees', 'items', 'updatedAt'])
                            && request.resource.data.fees is list
                            && request.resource.data.fees.size() <= 50
                            && (!('items' in request.resource.data)
                                || (request.resource.data.items is list && request.resource.data.items.size() <= 200))
                            && request.resource.data.updatedAt == request.time;
    }

    // Order totals shown on englerwebsites.com/payment, published from the Appraisals page.
    // Anyone can read one order's doc if they know its order number; nobody but the admin
    // can list them or write.
    match /orderTotals/{orderNo} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
                            && orderNo.matches('ENG-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}')
                            && request.resource.data.keys().hasOnly(['total', 'company', 'publishedAt'])
                            && request.resource.data.total is number
                            && request.resource.data.total >= 0
                            && request.resource.data.company is string
                            && request.resource.data.company.size() <= 200
                            && request.resource.data.publishedAt == request.time;
    }

    // Time tracking (portal/time-tracking.html): one doc per stretch of work. Admin only.
    // A stretch starts with no end and no description; pausing or checking out sets the end
    // once. Resuming after a pause starts a new stretch with the same session ID. Start,
    // person and session never change; descriptions can be written or edited afterwards.
    match /timeEntries/{entryId} {
      function fieldsOk(d) {
        return d.keys().hasOnly(['person', 'start', 'end', 'description', 'updatedAt', 'session', 'paused'])
            && d.description is string && d.description.size() <= 2000
            && (!('paused' in d) || d.paused is bool)
            && (!('session' in d) || (d.session is string && d.session.size() <= 40));
      }
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
                    && fieldsOk(request.resource.data)
                    && request.resource.data.person in ['Zay', 'Gabe', 'Joel']
                    && request.resource.data.start == request.time
                    && request.resource.data.end == null
                    && request.resource.data.get('paused', false) == false
                    && request.resource.data.description == ''
                    && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
                    && fieldsOk(request.resource.data)
                    && request.resource.data.person == resource.data.person
                    && request.resource.data.start == resource.data.start
                    && request.resource.data.get('session', '') == resource.data.get('session', '')
                    && (request.resource.data.end == resource.data.end
                        || (resource.data.end == null && request.resource.data.end == request.time))
                    && request.resource.data.updatedAt == request.time;
    }

  }
}
