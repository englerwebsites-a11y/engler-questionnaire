// Firestore rules for index.html.
//
// Paste this whole file into Firebase console > Firestore Database > Rules for
// the engler-questionnaire project, replacing what's there, then Publish.
//
// Anyone can create a submission. Only the admin account (signed in on
// responses.html) can read or delete them, and nobody can edit one.
// isAdmin() below holds the admin user's UID from
// Authentication > Users.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'TyahIAOe0ZgcOZC1d8xOf0j0DrT2';
    }

    match /questionnaireSubmissions/{submissionId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['companyName', 'answers', 'contacts', 'files', 'summary', 'submittedAt', 'userAgent'])
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() <= 200
                    && request.resource.data.answers is map
                    && request.resource.data.answers.size() <= 60
                    && request.resource.data.answers['AI Workflow Acknowledged'] == 'Yes'
                    && request.resource.data.contacts is list
                    && request.resource.data.contacts.size() <= 20
                    && request.resource.data.files is list
                    && request.resource.data.files.size() <= 20
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 100000
                    && request.resource.data.submittedAt == request.time;
    }

  }
}
